<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="LOKI.QRcodePage"
             BackgroundColor="Transparent"
             Shell.PresentationMode="ModalAnimated">
<Grid>

    <skia:SKCanvasView PaintSurface="OnCanvasPaintSurface" />

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, *, *, *" Padding="20">

        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"  Grid.ColumnSpan="4" Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Margin="10">
            <Image Source="{Binding QRcode, Mode=TwoWay}" WidthRequest="300" HeightRequest="300"/>
        </Border>

        <Button Grid.Row="0" Grid.Column="0" VerticalOptions="End" HorizontalOptions="Start" FontFamily="MDI" Text="&#xF0156;" FontSize="30" TextColor="#F4F1EA" BackgroundColor="Transparent" Command="{Binding BackCommand}"/>
    </Grid>

</Grid>
</ContentPage>